{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "TEST_DATABASE_URL",
    "TEST_APP_DATABASE_URL",
    "TEST_SERVICE_DATABASE_URL",
    "DATABASE_URL",
    "TYPESAFE_API_KEY",
    "OPENROUTER_API_KEY",
    "ANTHROPIC_API_KEY",
    "DATAFORSEO_LOGIN",
    "DATAFORSEO_PASSWORD",
    "DATAFORSEO_BASE_URL",
    "APIFY_TOKEN",
    "SCRAPECREATORS_API_KEY",
    "REVIEWER_HASH_SALT",
    "APP_URL",
    "LINK_SIGNING_SECRET",
    "LINK_SIGNING_SECRET_PREVIOUS",
    "EMAIL_FROM",
    "EMAIL_OUTBOX_DIR",
    "POSTMARK_SERVER_TOKEN",
    "POSTMARK_MESSAGE_STREAM",
    "APP_DATABASE_URL",
    "SERVICE_DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "DEFAULT_AGENCY_ID",
    "EVIDENCE_FS_DIR",
    "R2_ACCOUNT_ID",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "R2_BUCKET"
  ],
  "tasks": {
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "cache": false },
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "!.next/cache/**"] }
  }
}
