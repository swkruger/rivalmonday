{
  "name": "competitorspy",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "db:up": "docker compose up -d db",
    "db:migrate": "pnpm --filter @cs/db migrate",
    "db:snapshot": "pnpm --filter @cs/demo snapshot",
    "dev:web": "pnpm --filter @cs/web dev",
    "build": "turbo run build",
    "demo:reset": "pnpm --filter @cs/demo reset",
    "demo:links": "pnpm --filter @cs/demo links"
  },
  "devDependencies": {
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}
