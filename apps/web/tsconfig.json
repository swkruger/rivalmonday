  "include": ["next-env.d.ts", "src", "test", "scripts", "e2e", "e2e-panel", "vitest.config.ts", "playwright.config.ts", "playwright.panel.config.ts", "next.config.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
